    { "id": "REPEAT_CONTACT", "field": "reopened_count", "op": "gte", "value": 2, "bump": 1, "description": "Reopened two or more times" },
    { "id": "ENTERPRISE_TIER", "field": "customer_tier", "op": "eq", "value": "Enterprise", "bump": 1, "description": "Enterprise customer tier" }
  ],
