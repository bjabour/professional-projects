    "LOGIN-FAIL": { "implied_queue": "Account & Access", "assigned_team": "Account & Access - Identity" },
    "ACCOUNT-LOCKOUT": { "implied_queue": "Account & Access", "assigned_team": "Account & Access - Identity" },
    "SECURITY-CONCERN": { "implied_queue": "Account & Access", "assigned_team": "Account & Access - Security" },
    "API-ERROR": { "implied_queue": "Technical", "assigned_team": "Technical - Platform" },
    "BUG-REPORT": { "implied_queue": "Technical", "assigned_team": "Technical - Platform" },
    "OUTAGE-REPORT": { "implied_queue": "Technical", "assigned_team": "Technical - Platform" },
